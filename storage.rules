rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'stackflown@gmail.com'
             ];
    }

    // Listing photos — public read, only the owner of the slug can write.
    match /listings/{slug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
                     firestore.exists(/databases/(default)/documents/listingOwners/$(slug)) &&
                     firestore.get(/databases/(default)/documents/listingOwners/$(slug)).data.uid == request.auth.uid &&
                     request.resource.size < 5 * 1024 * 1024 &&           // 5MB max
                     request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null &&
                      firestore.exists(/databases/(default)/documents/listingOwners/$(slug)) &&
                      firestore.get(/databases/(default)/documents/listingOwners/$(slug)).data.uid == request.auth.uid;
    }
  }
}
