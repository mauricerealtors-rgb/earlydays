rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the signed-in user the reviewer role (admin)?
    // For MVP, hardcode the admin email(s). Rotate via env var later.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'stackflown@gmail.com'
             ];
    }

    // Public users doc — schools sign up here. Only the owner or admin can read/write.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Claims — submitted from /claim/<slug> with no account, so creation goes
    // through /api/claim on the Admin SDK (which bypasses these rules) rather
    // than from the client. Claimants can follow their own claim once they
    // have signed up, matched on the email they claimed with or on the uid we
    // attach at approval. Only admin can review or delete.
    match /claims/{claimId} {
      allow read: if request.auth != null &&
                    (isAdmin() ||
                     request.auth.uid == resource.data.uid ||
                     request.auth.token.email == resource.data.submittedEmail);
      allow create: if false; // only Admin SDK from /api/claim
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Outreach tracker — which unclaimed schools we've emailed, and the address
    // used. Admin-only, and written exclusively by /api/admin/outreach on the
    // Admin SDK so a sent/failed status can never be forged from a browser.
    // Call log — who we rang, what they said, when to try again. Admin-only,
    // and written exclusively by /api/admin/crm on the Admin SDK so an outcome
    // or a note can never be forged or edited from a browser console.
    match /schoolContacts/{slug} {
      allow read: if isAdmin();
      allow write: if false; // only Admin SDK from /api/admin/crm
    }

    match /outreach/{slug} {
      allow read: if isAdmin();
      allow write: if false; // only Admin SDK from /api/admin/outreach
    }

    // Listing overrides — school users can only edit listings they've claimed
    // and been approved for. Approval writes an entry in listingOwners.
    match /listingOverrides/{slug} {
      allow read: if true; // public reads for the site merger
      allow create, update: if isAdmin() ||
                              (request.auth != null &&
                               exists(/databases/$(database)/documents/listingOwners/$(slug)) &&
                               get(/databases/$(database)/documents/listingOwners/$(slug)).data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Ownership registry — one owner per slug. Only admin writes.
    match /listingOwners/{slug} {
      allow read: if request.auth != null &&
                    (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Photos subcollection — same ownership rules as overrides.
    match /listingOverrides/{slug}/photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() ||
                                       (request.auth != null &&
                                        exists(/databases/$(database)/documents/listingOwners/$(slug)) &&
                                        get(/databases/$(database)/documents/listingOwners/$(slug)).data.uid == request.auth.uid);
    }

    // Subscription state — read-only for the school user; only server can write.
    // Server writes are via Firebase Admin SDK (server-side) using service account,
    // which bypasses these rules entirely, so `allow write: if false` is safe.
    match /subscriptions/{slug} {
      allow read: if true;
      allow write: if false; // only Admin SDK from webhook
    }

    // Concierge requests — parent submits from /concierge without auth.
    // Reads restricted to admin (all writes bypass rules via Admin SDK).
    match /conciergeRequests/{requestId} {
      allow read: if isAdmin();
      allow update: if isAdmin(); // status transitions + internal notes
      allow delete: if isAdmin();
      allow create: if false; // only Admin SDK from /api/concierge
    }

    match /stats/concierge {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Schools who enquired about our website / management plans on /for-schools.
    match /schoolServiceEnquiries/{enquiryId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
      allow create: if false; // only Admin SDK from /api/for-schools/enquire
    }

    match /stats/schoolServiceEnquiries {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Enquiries (parent leads) — parent submits without auth; only owner reads.
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasOnly(
        ['slug','parentName','parentEmail','parentPhone','message','createdAt']
      );
      allow read, update: if request.auth != null &&
                            exists(/databases/$(database)/documents/listingOwners/$(resource.data.slug)) &&
                            get(/databases/$(database)/documents/listingOwners/$(resource.data.slug)).data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // CakesGhana (cakesghana.com)
    //
    // Second directory, same Firebase project by design — one service account,
    // one billing account, one set of env vars. Separation is by collection
    // prefix rather than by project, so nothing here can touch an EarlyDays
    // document and the rules for each read independently.
    // ---------------------------------------------------------------------

    // Vendor overrides — bakers edit only the listing they have been approved
    // for. Approval writes an entry in cakeVendorOwners.
    match /cakeVendorOverrides/{slug} {
      allow read: if true; // public reads for the site merger
      allow create, update: if isAdmin() ||
                              (request.auth != null &&
                               exists(/databases/$(database)/documents/cakeVendorOwners/$(slug)) &&
                               get(/databases/$(database)/documents/cakeVendorOwners/$(slug)).data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Portfolio photos — same ownership rule as the override itself.
    match /cakeVendorOverrides/{slug}/photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() ||
                                       (request.auth != null &&
                                        exists(/databases/$(database)/documents/cakeVendorOwners/$(slug)) &&
                                        get(/databases/$(database)/documents/cakeVendorOwners/$(slug)).data.uid == request.auth.uid);
    }

    // Ownership registry — one owner per slug, admin writes only.
    match /cakeVendorOwners/{slug} {
      allow read: if request.auth != null &&
                    (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Claims — submitted with no account from /claim/<slug>, so creation runs
    // through the Admin SDK rather than from a browser. Same call-to-verify
    // flow as EarlyDays: name, email, phone, no password.
    match /cakeVendorClaims/{claimId} {
      allow read: if request.auth != null &&
                    (isAdmin() ||
                     request.auth.uid == resource.data.uid ||
                     request.auth.token.email == resource.data.submittedEmail);
      allow create: if false; // only Admin SDK from /api/claim
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Quote requests — the product of the site. A buyer may send one request to
    // several bakers, so a request is readable by every owner it was sent to.
    // Created server-side only, so the vendor list cannot be forged to spam a
    // baker who was never shortlisted.
    match /cakeQuoteRequests/{requestId} {
      allow create: if false; // only Admin SDK from /api/quote
      allow read, update: if isAdmin() ||
                            (request.auth != null &&
                             resource.data.ownerUids.hasAny([request.auth.uid]));
      allow delete: if isAdmin();
    }

    // Reviews — written server-side after validation, published only once
    // reviewed. Public reads are filtered to published reviews.
    match /cakeReviews/{reviewId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if false; // only Admin SDK from /api/review
      allow update, delete: if isAdmin();
    }

    // Outreach tracker — which unclaimed bakers we have emailed. Admin SDK only,
    // so a sent status can never be forged from a browser.
    match /cakeOutreach/{slug} {
      allow read: if isAdmin();
      allow write: if false; // only Admin SDK
    }

    // Subscription state — readable so the public page can show a paid badge,
    // writable only by the Paystack webhook on the Admin SDK.
    match /cakeSubscriptions/{slug} {
      allow read: if true;
      allow write: if false; // only Admin SDK from webhook
    }

    match /stats/cakeQuoteRequests {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
