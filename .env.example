# Public site URL — used for canonical URLs, sitemap, JSON-LD
NEXT_PUBLIC_SITE_URL=https://earlydays.com.gh

# Firebase Web SDK config (public — safe to expose in browser)
# Security is enforced via Firebase Security Rules, not by hiding this config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
