# Public site URL — used for canonical URLs, sitemap, JSON-LD, OG tags,
# metadataBase. Must NOT include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://earlydays.cc

# Firebase Web SDK config (public — safe to expose in browser)
# Security is enforced via Firebase Security Rules, not by hiding this config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Paystack — school-side subscriptions (Verified / Featured tiers)
# Public key is safe in the browser; secret key MUST stay server-only.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Admin allowlist (comma-separated emails) for approving claims etc.
ADMIN_EMAILS=support@sellquic.com,mauricerealtors@gmail.com

# Cloudinary — used for school-uploaded photos on the dashboard
# Get cloud name from Cloudinary console. Preset must be UNSIGNED (Settings → Upload).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=earlydays_school_photos
CLOUDINARY_API_SECRET=

# Firebase Admin SDK — service-account JSON pasted as a single-line string.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Server-only. Never expose to the client.
FIREBASE_SERVICE_ACCOUNT_JSON=
