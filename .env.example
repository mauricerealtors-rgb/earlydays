# Public site URL — used for canonical URLs, sitemap, JSON-LD, OG tags,
# metadataBase. Must NOT include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://earlydays.cc

# Firebase Web SDK config (public — safe to expose in browser)
# Security is enforced via Firebase Security Rules, not by hiding this config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Paystack — school-side subscriptions (Verified / Featured tiers)
# Public key is safe in the browser; secret key MUST stay server-only.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Admin allowlist (comma-separated emails) for approving claims etc.
ADMIN_EMAILS=stackflown@gmail.com

# Cloudinary — used for school-uploaded photos on the dashboard
# Get cloud name from Cloudinary console. Preset must be UNSIGNED (Settings → Upload).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=earlydays_school_photos
CLOUDINARY_API_SECRET=

# Firebase Admin SDK — service-account JSON pasted as a single-line string.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Server-only. Never expose to the client.
FIREBASE_SERVICE_ACCOUNT_JSON=

# IndexNow admin token — protects /api/indexnow from public POSTs.
# Generate any long random string. Send as `Authorization: Bearer <token>`.
INDEXNOW_ADMIN_TOKEN=

# Resend — transactional mail + inbound forwarding.
# API key: Resend dashboard → API Keys. Server-only.
RESEND_API_KEY=

# Signing secret for the inbound webhook (starts whsec_).
# Resend → Webhooks → your endpoint → Signing Secret.
# Without this the /api/inbound route rejects every request.
RESEND_WEBHOOK_SECRET=

# Where mail sent to the domain gets forwarded, and the verified address it is
# re-sent from. FROM must be on a domain verified in Resend.
INBOUND_FORWARD_TO=stackflown@gmail.com
INBOUND_FORWARD_FROM=maurice@earlydays.cc

# School outreach (/admin/outreach). FROM must be on the verified Resend domain.
OUTREACH_FROM=maurice@earlydays.cc
OUTREACH_SENDER_NAME=Maurice Nyamah
OUTREACH_REPLY_TO=maurice@earlydays.cc
